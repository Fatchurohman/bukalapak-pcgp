<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kontrol Admin Rahasia - Pasar Candi Gebang Permai</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>
    
    <style>
        :root {
            --primary: #0f172a;
            --accent: #d97706;
            --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            --card-bg: rgba(255, 255, 255, 0.95);
            --text-main: #334155;
            --radius: 16px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }

        body {
            background: var(--bg-gradient);
            color: var(--text-main);
            min-height: 100vh;
            padding: 2rem 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Kotak Login PIN */
        #pinContainer {
            width: 100%; max-width: 400px;
            background: var(--card-bg); padding: 2.5rem; border-radius: var(--radius);
            box-shadow: 0 25px 50px rgba(0,0,0,0.25); text-align: center;
        }
        #pinContainer h2 { color: var(--primary); margin-bottom: 0.5rem; font-size: 1.5rem; }
        #pinContainer p { color: #64748b; font-size: 0.9rem; margin-bottom: 1.5rem; }
        .pin-input {
            width: 100%; padding: 0.85rem; font-size: 1.2rem; text-align: center;
            letter-spacing: 0.3rem; border: 1px solid #cbd5e1; border-radius: 10px; outline: none; margin-bottom: 1rem;
        }
        .btn-pin {
            width: 100%; background: var(--accent); color: white; border: none; padding: 0.85rem;
            border-radius: 10px; font-weight: 700; font-size: 1rem; cursor: pointer;
        }
        .btn-pin:hover { background: #b45309; }

        /* Panel Kontrol Utama (Disembunyikan Sebelum Masukkan PIN) */
        #controlPanel { display: none; width: 100%; max-width: 900px; margin: 0 auto; }
        
        header { text-align: center; margin-bottom: 2rem; color: #fff; position: relative; }
        .nav-home-btn {
            position: absolute; top: 0; left: 0;
            background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff; padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 600;
            text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; backdrop-filter: blur(5px);
        }
        .nav-home-btn:hover { background: rgba(255, 255, 255, 0.2); }
        @media (max-width: 768px) { .nav-home-btn { position: relative; margin-bottom: 1rem; } }

        header h1 { font-size: 2.2rem; font-weight: 700; margin-bottom: 0.5rem; color: #fbbf24; }
        header p { color: #94a3b8; font-size: 1rem; }

        .card {
            background: var(--card-bg); border-radius: var(--radius); padding: 2rem;
            box-shadow: 0 20px 25px rgba(0,0,0,0.1); backdrop-filter: blur(10px);
        }
        
        .table-responsive { width: 100%; overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; margin-top: 1rem; text-align: left; }
        th, td { padding: 0.85rem; border-bottom: 1px solid #e2e8f0; font-size: 0.9rem; }
        th { background: #f8fafc; color: var(--primary); font-weight: 700; }
        
        .btn-action {
            padding: 0.4rem 0.75rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600;
            cursor: pointer; border: none; display: inline-flex; align-items: center; gap: 0.3rem; margin-right: 0.3rem;
        }
        .btn-edit { background: #2563eb; color: #fff; }
        .btn-delete { background: #dc2626; color: #fff; }

        /* Modal Edit */
        .modal-overlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6); backdrop-filter: blur(5px); z-index: 1000;
            align-items: center; justify-content: center; padding: 1rem;
        }
        .modal-card {
            background: #fff; width: 100%; max-width: 500px; border-radius: 16px; padding: 2rem;
            box-shadow: 0 25px 50px rgba(0,0,0,0.25); max-height: 90vh; overflow-y: auto;
        }
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.3rem; }
        .form-control { width: 100%; padding: 0.6rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; }
    </style>
</head>
<body>

    <!-- Kotak Verifikasi PIN Rahasia -->
    <div id="pinContainer">
        <h2><i class="fa-solid fa-lock" style="color: var(--accent);"></i> Akses Terbatas</h2>
        <p>Masukkan PIN Rahasia Pengurus / Admin untuk membuka panel kontrol.</p>
        <input type="password" id="pinInput" class="pin-input" placeholder="••••" maxlength="6">
        <button type="button" class="btn-pin" onclick="verifyPin()">Buka Panel</button>
        <p style="margin-top: 1.5rem; font-size: 0.8rem;"><a href="index.html" style="color: #64748b; text-decoration: none;"><i class="fa-solid fa-arrow-left"></i> Kembali ke Beranda</a></p>
    </div>

    <!-- Panel Kontrol Utama -->
    <div id="controlPanel">
        <div class="container">
            <header>
                <a href="admin.html" class="nav-home-btn"><i class="fa-solid fa-arrow-left"></i> Kembali ke Form</a>
                <h1><i class="fa-solid fa-sliders"></i> Kontrol Admin Rahasia</h1>
                <p>Kelola, Edit, atau Hapus Seluruh Data Produk Warga</p>
            </header>

            <div class="card">
                <h2>Daftar Seluruh Produk Aktif</h2>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Toko</th>
                                <th>Produk</th>
                                <th>Kategori</th>
                                <th>Harga</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="adminTableBody">
                            <tr><td colspan="5" style="text-align: center; padding: 2rem;">Memuat data...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Edit Produk -->
    <div id="editModal" class="modal-overlay">
        <div class="modal-card">
            <h3 style="margin-bottom: 1rem; color: var(--primary);">Edit Data Produk</h3>
            <form id="editForm">
                <input type="hidden" id="editId">
                <div class="form-group">
                    <label>Nama Toko</label>
                    <input type="text" id="editNamaToko" class="form-control" required>
                </div>
                <div class="form-group">
                    <label>Nama Produk</label>
                    <input type="text" id="editNama" class="form-control" required>
                </div>
                <div class="form-group">
                    <label>Kategori</label>
                    <select id="editKategori" class="form-control">
                        <option value="Sembako & Bahan Pokok">Sembako & Bahan Pokok</option>
                        <option value="Kuliner / Masakan">Kuliner / Masakan</option>
                        <option value="Frozen Food">Frozen Food</option>
                        <option value="Fashion & Lainnya">Fashion & Lainnya</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Harga (Rp)</label>
                    <input type="number" id="editHarga" class="form-control" required>
                </div>
                <div class="form-group">
                    <label>Nomor WhatsApp</label>
                    <input type="text" id="editNoWa" class="form-control" required>
                </div>
                <div class="form-group">
                    <label>Deskripsi</label>
                    <textarea id="editDeskripsi" class="form-control" rows="3" required></textarea>
                </div>
                <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
                    <button type="button" class="btn-action" style="background:#cbd5e1; color:#334155; flex:1; padding:0.7rem;" onclick="closeEditModal()">Batal</button>
                    <button type="submit" class="btn-action" style="background:#2563eb; color:#fff; flex:1; padding:0.7rem; justify-content:center;">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>

    <script src="config.js"></script>
    <script>
        // ATUR PIN RAHASIA ADMIN ANDA DI SINI (Contoh: 6262)
        const ADMIN_PIN = "6262";

        function verifyPin() {
            const enteredPin = document.getElementById('pinInput').value.trim();
            if (enteredPin === ADMIN_PIN) {
                document.getElementById('pinContainer').style.display = 'none';
                document.getElementById('controlPanel').style.display = 'block';
                loadAdminData();
            } else {
                alert("PIN Rahasia Salah! Akses ditolak.");
                document.getElementById('pinInput').value = '';
            }
        }

        const tableBody = document.getElementById('adminTableBody');
        const editModal = document.getElementById('editModal');
        const editForm = document.getElementById('editForm');

        function loadAdminData() {
            if (!db) return;

            db.collection('products').orderBy('createdAt', 'desc').onSnapshot((snapshot) => {
                tableBody.innerHTML = '';

                if (snapshot.empty) {
                    tableBody.innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 2rem; color: #64748b;">Belum ada data produk.</td></tr>`;
                    return;
                }

                snapshot.forEach(doc => {
                    const item = doc.data();
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td><strong>${item.namaToko || '-'}</strong></td>
                        <td>${item.nama || '-'}</td>
                        <td><span style="font-size:0.75rem; background:#fef3c7; color:#d97706; padding:0.2rem 0.5rem; border-radius:4px; font-weight:700;">${item.kategori || '-'}</span></td>
                        <td>Rp ${Number(item.harga || 0).toLocaleString('id-ID')}</td>
                        <td>
                            <button class="btn-action btn-edit" onclick="openEditModal('${doc.id}', '${encodeURIComponent(item.namaToko || '')}', '${encodeURIComponent(item.nama || '')}', '${encodeURIComponent(item.kategori || '')}', '${item.harga || 0}', '${encodeURIComponent(item.noWa || '')}', '${encodeURIComponent(item.deskripsi || '')}')"><i class="fa-solid fa-pen"></i> Edit</button>
                            <button class="btn-action btn-delete" onclick="deleteProduct('${doc.id}')"><i class="fa-solid fa-trash"></i> Hapus</button>
                        </td>
                    `;
                    tableBody.appendChild(tr);
                });
            });
        }

        function openEditModal(id, toko, nama, kategori, harga, noWa, deskripsi) {
            document.getElementById('editId').value = id;
            document.getElementById('editNamaToko').value = decodeURIComponent(toko);
            document.getElementById('editNama').value = decodeURIComponent(nama);
            document.getElementById('editKategori').value = decodeURIComponent(kategori);
            document.getElementById('editHarga').value = harga;
            document.getElementById('editNoWa').value = decodeURIComponent(noWa);
            document.getElementById('editDeskripsi').value = decodeURIComponent(deskripsi);
            editModal.style.display = 'flex';
        }

        function closeEditModal() {
            editModal.style.display = 'none';
        }

        editForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('editId').value;
            const updatedData = {
                namaToko: document.getElementById('editNamaToko').value.trim(),
                nama: document.getElementById('editNama').value.trim(),
                kategori: document.getElementById('editKategori').value,
                harga: Number(document.getElementById('editHarga').value),
                noWa: document.getElementById('editNoWa').value.trim(),
                deskripsi: document.getElementById('editDeskripsi').value.trim()
            };

            try {
                await db.collection('products').doc(id).update(updatedData);
                alert("Data produk berhasil diperbarui!");
                closeEditModal();
            } catch (err) {
                console.error("Gagal update:", err);
                alert("Gagal memperbarui data.");
            }
        });

        async function deleteProduct(id) {
            if (confirm("Yakin ingin menghapus produk ini dari server?")) {
                try {
                    await db.collection('products').doc(id).delete();
                } catch (err) {
                    console.error("Gagal hapus:", err);
                    alert("Gagal menghapus produk.");
                }
            }
        }
    </script>
</body>
</html>
